<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.rapidswing</groupId>
        <artifactId>rapidswing-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>rapidswing-demo</artifactId>
    <name>RapidSwing Demo</name>
    <description>Sample application built on RapidSwing</description>

    <dependencies>
        <dependency>
            <groupId>com.rapidswing</groupId>
            <artifactId>rapidswing-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rapidswing</groupId>
            <artifactId>rapidswing-binding</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rapidswing</groupId>
            <artifactId>rapidswing-forms</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rapidswing</groupId>
            <artifactId>rapidswing-table</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rapidswing</groupId>
            <artifactId>rapidswing-crud</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rapidswing</groupId>
            <artifactId>rapidswing-logviewer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rapidswing</groupId>
            <artifactId>rapidswing-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.rapidswing</groupId>
            <artifactId>rapidswing-testing</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Let Java detect whether a display exists: screen tests run locally and skip on headless CI. -->
                    <systemPropertyVariables combine.self="override"/>
                </configuration>
            </plugin>
            <!-- Builds an executable fat jar: target/rapidswing-demo-<version>-app.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>app</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.rapidswing.demo.DemoApp</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
