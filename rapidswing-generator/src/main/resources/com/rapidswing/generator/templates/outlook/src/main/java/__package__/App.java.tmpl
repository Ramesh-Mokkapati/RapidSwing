package {{package}};

import com.rapidswing.app.AppContext;
import com.rapidswing.app.SwingApp;
import com.rapidswing.i18n.I18n;
{{#if login}}
import com.rapidswing.security.Authenticator;
import com.rapidswing.security.User;
{{/if}}
import com.rapidswing.ui.AppAction;
import com.rapidswing.ui.View;

/** {{appName}}: an Outlook-style application. Generated by RapidSwing: customize freely. */
public class App extends SwingApp {

    public static void main(String[] args) {
{{#if logviewer}}
        AppSupport.configureLogFile("{{artifactId}}");
{{/if}}
        new App().launch(args);
    }
{{#if login}}

    @Override
    protected Authenticator authenticator(AppContext ctx) {
        return AppSupport.authenticator();
    }
{{/if}}

    @Override
    protected void buildUi(AppContext ctx) {
        I18n i18n = ctx.i18n();
        ctx.views().register("main", () -> new OutlookView(ctx));

        AppAction mail = AppSupport.action(i18n, "outlook.mail", () -> section(ctx, "mail")).shortcut("ctrl 1");
        AppAction contacts = AppSupport.action(i18n, "outlook.contacts", () -> section(ctx, "contacts")).shortcut("ctrl 2");
        AppAction tasks = AppSupport.action(i18n, "outlook.tasks", () -> section(ctx, "tasks")).shortcut("ctrl 3");

        AppSupport.addFileMenu(this, ctx);
        ctx.mainFrame().addMenu("view", mail, contacts, tasks, null);
        AppSupport.addCommonMenus(this, ctx);
    }
{{#if login}}

    @Override
    protected void onLogin(AppContext ctx, User user) {
        ctx.views().show("main");
        ctx.mainFrame().statusBar().setMessage(ctx.i18n().get("status.signedIn", user.getDisplayName()));
    }
{{/if}}
{{#unless login}}

    @Override
    protected void onReady(AppContext ctx) {
        ctx.views().show("main");
        ctx.mainFrame().statusBar().setMessage(ctx.i18n().get("status.ready"));
    }
{{/unless}}

    private static void section(AppContext ctx, String id) {
        if (!"main".equals(ctx.views().currentId().get())) {
            ctx.views().show("main");
        }
        View main = ctx.views().currentView().get();
        if (main instanceof OutlookView) {
            ((OutlookView) main).showSection(id);
        }
    }
}
