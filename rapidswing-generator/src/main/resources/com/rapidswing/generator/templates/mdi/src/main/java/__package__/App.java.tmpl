package {{package}};

import com.rapidswing.app.AppContext;
import com.rapidswing.app.SwingApp;
import com.rapidswing.i18n.I18n;
{{#if login}}
import com.rapidswing.security.Authenticator;
import com.rapidswing.security.User;
{{/if}}
import com.rapidswing.ui.AppAction;

import javax.swing.JMenu;

/** {{appName}}: a multiple-document (MDI) application. Generated by RapidSwing: customize freely. */
public class App extends SwingApp {

    private WorkspaceView workspace;

    public static void main(String[] args) {
{{#if logviewer}}
        AppSupport.configureLogFile("{{artifactId}}");
{{/if}}
        new App().launch(args);
    }
{{#if login}}

    @Override
    protected Authenticator authenticator(AppContext ctx) {
        return AppSupport.authenticator();
    }
{{/if}}

    @Override
    protected void buildUi(AppContext ctx) {
        I18n i18n = ctx.i18n();
        // One workspace for the lifetime of the window: rebuilding views (e.g. on a language switch) keeps it.
        workspace = new WorkspaceView(ctx);
        ctx.views().register("main", () -> workspace);

        AppAction newDocument = AppSupport.action(i18n, "action.new", () -> workspace.newDocument()).shortcut("ctrl N");
        AppAction open = AppSupport.action(i18n, "action.open", () -> workspace.open()).shortcut("ctrl O");
        AppAction save = AppSupport.action(i18n, "action.save", () -> workspace.save()).shortcut("ctrl S");
        AppAction saveAs = AppSupport.action(i18n, "action.saveAs", () -> workspace.saveAs()).shortcut("ctrl shift S");
        AppAction close = AppSupport.action(i18n, "action.close", () -> workspace.closeActive()).shortcut("ctrl W");

        AppSupport.addFileMenu(this, ctx, newDocument, open, save, saveAs, close);
        JMenu window = workspace.getWorkspace().windowMenu();
        ctx.mainFrame().getJMenuBar().add(window);
        AppSupport.addCommonMenus(this, ctx);
        ctx.mainFrame().addToolbar(newDocument, open, save);
    }
{{#if login}}

    @Override
    protected void onLogin(AppContext ctx, User user) {
        // A new user starts with an empty workspace, never with the previous user's documents.
        workspace.reset();
        ctx.views().show("main");
        workspace.newDocument();
        ctx.mainFrame().statusBar().setMessage(ctx.i18n().get("status.signedIn", user.getDisplayName()));
    }
{{/if}}
{{#unless login}}

    @Override
    protected void onReady(AppContext ctx) {
        ctx.views().show("main");
        workspace.newDocument();
        ctx.mainFrame().statusBar().setMessage(ctx.i18n().get("status.ready"));
    }
{{/unless}}
}
