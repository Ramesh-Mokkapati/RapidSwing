package {{package}};

import com.rapidswing.app.AppContext;
import com.rapidswing.app.SwingApp;
import com.rapidswing.i18n.I18n;
{{#if login}}
import com.rapidswing.security.Authenticator;
import com.rapidswing.security.User;
{{/if}}
import com.rapidswing.ui.AppAction;

/** {{appName}}: a single-document (SDI) application. Generated by RapidSwing: customize freely. */
public class App extends SwingApp {

    private DocumentView document;

    public static void main(String[] args) {
{{#if logviewer}}
        AppSupport.configureLogFile("{{artifactId}}");
{{/if}}
        new App().launch(args);
    }
{{#if login}}

    @Override
    protected Authenticator authenticator(AppContext ctx) {
        return AppSupport.authenticator();
    }
{{/if}}

    @Override
    protected void buildUi(AppContext ctx) {
        I18n i18n = ctx.i18n();
        // One document for the lifetime of the window: rebuilding views (e.g. on a language switch) keeps it.
        document = new DocumentView(ctx);
        ctx.views().register("main", () -> document);

        AppAction newDocument = AppSupport.action(i18n, "action.new", () -> document.newDocument()).shortcut("ctrl N");
        AppAction open = AppSupport.action(i18n, "action.open", () -> document.open()).shortcut("ctrl O");
        AppAction save = AppSupport.action(i18n, "action.save", () -> document.save()).shortcut("ctrl S");
        AppAction saveAs = AppSupport.action(i18n, "action.saveAs", () -> document.saveAs()).shortcut("ctrl shift S");

        AppSupport.addFileMenu(this, ctx, newDocument, open, save, saveAs);
        AppSupport.addCommonMenus(this, ctx);
        ctx.mainFrame().addToolbar(newDocument, open, save);
    }
{{#if login}}

    @Override
    protected void onLogin(AppContext ctx, User user) {
        // A new user starts with an empty document, never with the previous user's text.
        document.reset();
        ctx.views().show("main");
        ctx.mainFrame().statusBar().setMessage(ctx.i18n().get("status.signedIn", user.getDisplayName()));
    }
{{/if}}
{{#unless login}}

    @Override
    protected void onReady(AppContext ctx) {
        ctx.views().show("main");
        ctx.mainFrame().statusBar().setMessage(ctx.i18n().get("status.ready"));
    }
{{/unless}}
}
