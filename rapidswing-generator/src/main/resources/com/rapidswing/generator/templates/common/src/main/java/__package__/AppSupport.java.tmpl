/** Menus and features shared by the application. Generated by RapidSwing: customize freely. */
final class AppSupport {

    private AppSupport() {
    }
{{#if login}}

    /** The application's accounts. Only password hashes are stored: create new ones with PasswordHasher. */
    static Authenticator authenticator() {
        return new SimpleAuthenticator()
                .addUser("admin", "Administrator", "{{adminHash}}", "admin");
    }
{{/if}}
{{#if logviewer}}

    /** Sends log output to a file the log viewer can show. Call it before anything logs. */
    static void configureLogFile(String appId) {
        Path file = logFile(appId);
        try {
            Files.createDirectories(file.getParent());
        } catch (IOException e) {
            return;
        }
        System.setProperty("org.slf4j.simpleLogger.logFile", file.toString());
        System.setProperty("org.slf4j.simpleLogger.showDateTime", "true");
        System.setProperty("org.slf4j.simpleLogger.dateTimeFormat", "yyyy-MM-dd HH:mm:ss.SSS");
    }

    static Path logFile(String appId) {
        return Paths.get(System.getProperty("user.home"), "." + appId, appId + ".log");
    }
{{/if}}

    /** An action whose name follows the language. */
    static AppAction action(I18n i18n, String key, Runnable handler) {
        AppAction action = AppAction.of(key, handler);
        i18n.bindAction(action, key);
        return action;
    }

    /** The File menu: the given document actions, then {{#if login}}Sign out and {{/if}}Exit. */
    static void addFileMenu(SwingApp app, AppContext ctx, Action... documentActions) {
        I18n i18n = ctx.i18n();
        MainFrame frame = ctx.mainFrame();
        frame.addMenu("file", documentActions);
        if (documentActions.length > 0) {
            frame.menu("file").addSeparator();
        }
{{#if login}}
        frame.addMenu("file", action(i18n, "action.signOut", app::logout), null);
{{/if}}
        frame.addMenu("file", action(i18n, "action.exit", app::exit).shortcut("ctrl Q"));
        i18n.bind(frame.menu("file")::setText, "menu.file");
    }

    /** The View, {{#if tools}}Tools, {{/if}}{{#if rest}}API, {{/if}}and Help menus, and the window title. */
    static void addCommonMenus(SwingApp app, AppContext ctx) {
        I18n i18n = ctx.i18n();
        MainFrame frame = ctx.mainFrame();
        frame.addMenu("view", action(i18n, "action.toggleTheme",
                () -> Themes.switchTo(Themes.isDark() ? Themes.LIGHT : Themes.DARK)).shortcut("ctrl T"));
{{#if i18n}}
        JMenu languages = languageMenu(app);
        frame.menu("view").addSeparator();
        frame.menu("view").add(languages);
        i18n.bind(languages::setText, "menu.language");
{{/if}}
        i18n.bind(frame.menu("view")::setText, "menu.view");
{{#if logviewer}}
        String appId = ctx.config().get("app.id", "app");
        ctx.views().register("logs", () -> {
            LogViewer viewer = new LogViewer(ctx.tasks());
            viewer.open(logFile(appId));
            return viewer;
        });
        frame.addMenu("tools", action(i18n, "action.logViewer", () -> ctx.views().show("logs")));
{{/if}}
{{#if encryption}}
        frame.addMenu("tools", action(i18n, "action.encryptFile", () -> transformFile(ctx, true)),
                action(i18n, "action.decryptFile", () -> transformFile(ctx, false)));
{{/if}}
{{#if tools}}
        i18n.bind(frame.menu("tools")::setText, "menu.tools");
{{/if}}
{{#if rest}}
        RestClient client = new RestClient(ctx.config().get("api.url", "{{apiUrl}}"));
        ApiViews.register(ctx, client);
        for (Map.Entry<String, String> view : ApiViews.titles().entrySet()) {
            frame.addMenu("api", AppAction.of(view.getValue(), () -> ctx.views().show(view.getKey())));
        }
        i18n.bind(frame.menu("api")::setText, "menu.api");
{{/if}}
        frame.addMenu("help", action(i18n, "action.about",
                () -> ctx.dialogs().info(i18n.get("action.about"), i18n.get("about.text"))));
        i18n.bind(frame.menu("help")::setText, "menu.help");
        i18n.bind(frame::setBaseTitle, "app.title");
    }
{{#if i18n}}

    /** Language names in their own language, so users can always find theirs. */
    private static JMenu languageMenu(SwingApp app) {
        Map<String, Locale> languages = new LinkedHashMap<>();
        languages.put("English", Locale.ENGLISH);
        languages.put("Deutsch", Locale.GERMAN);
        languages.put("Español", new Locale("es"));
        JMenu menu = new JMenu();
        ButtonGroup group = new ButtonGroup();
        Map<JRadioButtonMenuItem, Locale> items = new LinkedHashMap<>();
        for (Map.Entry<String, Locale> language : languages.entrySet()) {
            JRadioButtonMenuItem item = new JRadioButtonMenuItem(language.getKey());
            item.addActionListener(e -> {
                app.switchLocale(language.getValue());
                String current = I18n.global().getLocale().getLanguage();
                items.forEach((candidate, locale) -> candidate.setSelected(locale.getLanguage().equals(current)));
            });
            item.setSelected(I18n.global().getLocale().getLanguage().equals(language.getValue().getLanguage()));
            group.add(item);
            menu.add(item);
            items.put(item, language.getValue());
        }
        return menu;
    }
{{/if}}
{{#if encryption}}

    /** Encrypts or decrypts a file with a password (AES-256-GCM), in the background. */
    private static void transformFile(AppContext ctx, boolean encrypt) {
        I18n i18n = ctx.i18n();
        JFileChooser chooser = new JFileChooser();
        if (chooser.showOpenDialog(ctx.mainFrame()) != JFileChooser.APPROVE_OPTION) {
            return;
        }
        File source = chooser.getSelectedFile();
        String name = source.getName();
        String suggested = encrypt ? name + ".enc"
                : name.endsWith(".enc") ? name.substring(0, name.length() - 4) : name + ".decrypted";
        chooser.setSelectedFile(new File(source.getParentFile(), suggested));
        if (chooser.showSaveDialog(ctx.mainFrame()) != JFileChooser.APPROVE_OPTION) {
            return;
        }
        File target = chooser.getSelectedFile();
        char[] password = askPassword(ctx, encrypt);
        if (password == null) {
            return;
        }
        ctx.tasks().call(() -> {
            Encryptor encryptor = Encryptor.withPassword(password);
            try {
                if (encrypt) {
                    encryptor.encryptFile(source.toPath(), target.toPath());
                } else {
                    encryptor.decryptFile(source.toPath(), target.toPath());
                }
            } finally {
                encryptor.destroy();
                Arrays.fill(password, '\0');
            }
            return target;
        }).onSuccess(file -> ctx.mainFrame().statusBar()
                .setMessage(i18n.get(encrypt ? "crypto.encrypted" : "crypto.decrypted", file.getName())))
                .onError(e -> ctx.dialogs().error(i18n.get("crypto.failed"), e))
                .start();
    }

    /** Asks for a password, twice when encrypting. Returns {@code null} if cancelled or mistyped. */
    private static char[] askPassword(AppContext ctx, boolean confirm) {
        I18n i18n = ctx.i18n();
        JPasswordField first = new JPasswordField(20);
        JPasswordField second = new JPasswordField(20);
        JPanel panel = new JPanel(new GridLayout(0, 1, 4, 4));
        panel.add(new JLabel(i18n.get("crypto.password")));
        panel.add(first);
        if (confirm) {
            panel.add(new JLabel(i18n.get("crypto.repeat")));
            panel.add(second);
        }
        int answer = JOptionPane.showConfirmDialog(ctx.mainFrame(), panel,
                i18n.get(confirm ? "action.encryptFile" : "action.decryptFile"),
                JOptionPane.OK_CANCEL_OPTION, JOptionPane.PLAIN_MESSAGE);
        if (answer != JOptionPane.OK_OPTION) {
            return null;
        }
        char[] password = first.getPassword();
        if (confirm) {
            char[] repeated = second.getPassword();
            boolean same = Arrays.equals(password, repeated);
            Arrays.fill(repeated, '\0');
            if (!same) {
                Arrays.fill(password, '\0');
                ctx.dialogs().warn(i18n.get("crypto.mismatch"));
                return null;
            }
        }
        return password.length == 0 ? null : password;
    }
{{/if}}
